{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Mini payment gateway (learning project)",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @gateway/e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @gateway/db migrate",
    "db:seed": "pnpm --filter @gateway/db seed",
    "db:reset": "pnpm --filter @gateway/db reset"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
