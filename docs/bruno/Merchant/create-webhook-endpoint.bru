meta {
  name: Create webhook endpoint
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/webhook_endpoints
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "url": "http://localhost:3001/webhooks/gateway",
    "event_types": [
      "*"
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("endpointId", res.body.id);
  }
}

docs {
  The `secret` is in this response only. Local URLs need `ALLOW_PRIVATE_WEBHOOK_URLS=true`.
}
