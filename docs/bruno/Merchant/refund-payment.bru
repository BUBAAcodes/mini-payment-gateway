meta {
  name: Refund payment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/payments/{{paymentId}}/refunds
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "amount": 10000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("refundId", res.body.id);
  }
}

docs {
  Leave out `amount` to refund whatever is left.
}
