meta {
  name: Pay with card
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/checkout/orders/{{orderId}}/pay?cs={{clientSecret}}
  body: json
  auth: none
}

params:query {
  cs: {{clientSecret}}
}

body:json {
  {
    "method": "card",
    "card": {
      "number": "4111 1111 1111 1111",
      "expiry_month": 12,
      "expiry_year": 2030,
      "name": "Test Customer"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("paymentId", res.body.id);
  }
}

docs {
  Cards ending 1111 are approved and 0002 declined, after the OTP. Then **Submit OTP**.
}
