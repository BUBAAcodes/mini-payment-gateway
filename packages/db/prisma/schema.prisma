// The connection URL lives in prisma.config.ts (Prisma 7).
//
// Conventions: camelCase fields mapped to snake_case columns; money is Int paise; every timestamp
// is timestamptz. IDs the API shows are prefixed (pay_, order_...) and set by the app with newId().
// Internal tables get a Postgres-generated UUID so raw SQL inserts work too.
//
// Rules Prisma can't express live in raw SQL migrations: CHECK constraints, the ledger balance
// trigger and the append-only triggers (see migrations/*_ledger_guards_and_checks).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Merchants and access ----------

model Merchant {
  id                    String   @id
  name                  String
  /// AES-256-GCM ciphertext (encryptSecret). Signs checkout redirects.
  checkoutSigningSecret String   @map("checkout_signing_secret")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  apiKeys              ApiKey[]
  orders               Order[]
  payments             Payment[]
  refunds              Refund[]
  ledgerAccounts       LedgerAccount[]
  idempotencyKeys      IdempotencyKey[]
  events               Event[]
  webhookEndpoints     WebhookEndpoint[]
  settlements          Settlement[]
  reconciliationIssues ReconciliationIssue[]

  @@map("merchants")
}

model ApiKey {
  id         String    @id
  merchantId String    @map("merchant_id")
  /// First 12 characters of the key, stored in the clear to find the row.
  prefix     String    @unique
  /// SHA-256 hex of the full key. The key itself is never stored.
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("api_keys")
}

// Dashboard logins. User, Session, Account and Verification follow Better Auth's core schema
// (step 19); the only addition is users.merchant_id.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// The merchant this login belongs to. Nullable so Better Auth can create the user first.
  merchantId    String?  @map("merchant_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant? @relation(fields: [merchantId], references: [id])
  sessions Session[]
  accounts Account[]

  @@index([merchantId])
  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  /// "credential" for email + password logins.
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Better Auth's scrypt hash, "salt:key" in hex.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------- Orders and payments ----------

enum OrderStatus {
  created
  attempted
  paid

  @@map("order_status")
}

enum PaymentStatus {
  created
  otp_required
  pending
  authorized
  captured
  failed
  refunded

  @@map("payment_status")
}

enum PaymentMethod {
  upi
  card

  @@map("payment_method")
}

enum RefundStatus {
  pending
  processed
  failed

  @@map("refund_status")
}

model Order {
  id               String      @id
  merchantId       String      @map("merchant_id")
  /// Paise. CHECK (amount BETWEEN 100 AND 50000000).
  amount           Int
  currency         String      @default("INR")
  receipt          String?
  notes            Json?
  status           OrderStatus @default(created)
  /// SHA-256 hex of the cs_ client secret.
  clientSecretHash String      @map("client_secret_hash")
  callbackUrl      String?     @map("callback_url")
  paidAt           DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  payments Payment[]

  @@index([merchantId, createdAt])
  @@map("orders")
}

model Payment {
  id               String        @id
  merchantId       String        @map("merchant_id")
  orderId          String        @map("order_id")
  amount           Int
  /// Set when the payment is captured.
  fee              Int?
  /// CHECK (amount_refunded BETWEEN 0 AND amount): no over-refunds, even if a service has a bug.
  amountRefunded   Int           @default(0) @map("amount_refunded")
  currency         String        @default("INR")
  method           PaymentMethod
  vpa              String?
  /// Only the last four digits and the network. Full card numbers are never stored.
  cardLast4        String?       @map("card_last4")
  cardNetwork      String?       @map("card_network")
  status           PaymentStatus @default(created)
  failureReason    String?       @map("failure_reason")
  bankRef          String?       @map("bank_ref")
  bankStatusChecks Int           @default(0) @map("bank_status_checks")
  authorizedAt     DateTime?     @map("authorized_at") @db.Timestamptz(3)
  capturedAt       DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
  refunds  Refund[]

  // Rule 5: at most one attempt per order is in progress at a time. Declared here (partialIndexes
  // preview) rather than in raw SQL, because Prisma drops partial indexes it doesn't know about.
  // Side effect: the client accepts findUnique({ where: { orderId } }). Don't use it; an order can
  // have many payments, and only the in-progress one is unique.
  @@unique([orderId], map: "one_active_attempt", where: raw("status = ANY (ARRAY['created'::payment_status, 'otp_required'::payment_status, 'pending'::payment_status, 'authorized'::payment_status])"))
  @@index([orderId])
  @@index([merchantId, createdAt])
  @@index([status])
  @@map("payments")
}

model Refund {
  id            String       @id
  merchantId    String       @map("merchant_id")
  paymentId     String       @map("payment_id")
  /// Paise. CHECK (amount > 0).
  amount        Int
  status        RefundStatus @default(pending)
  bankRef       String?      @map("bank_ref")
  failureReason String?      @map("failure_reason")
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([merchantId, createdAt])
  @@map("refunds")
}

// ---------- Ledger (append-only, double-entry) ----------

enum LedgerAccountType {
  asset
  liability
  revenue

  @@map("ledger_account_type")
}

enum LedgerTransactionType {
  capture
  refund
  payout
  reversal

  @@map("ledger_transaction_type")
}

enum LedgerDirection {
  debit
  credit

  @@map("ledger_direction")
}

model LedgerAccount {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// gateway_clearing, fee_revenue, payouts, or merchant_balance:{merchantId}.
  code       String            @unique
  type       LedgerAccountType
  merchantId String?           @map("merchant_id")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant?     @relation(fields: [merchantId], references: [id])
  entries  LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id            String                @id
  type          LedgerTransactionType
  /// What this transaction records, e.g. "payment" + pay_...
  referenceType String                @map("reference_type")
  referenceId   String                @map("reference_id")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String          @map("transaction_id")
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  /// Paise. CHECK (amount > 0); the direction carries the sign.
  amount        Int
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  // The balance trigger sums entries by transaction; balances sum them by account.
  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

// ---------- Reliability ----------

enum IdempotencyState {
  in_progress
  completed

  @@map("idempotency_state")
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed

  @@map("webhook_delivery_status")
}

model IdempotencyKey {
  merchantId     String           @map("merchant_id")
  key            String
  method         String
  path           String
  /// SHA-256 of the request body, to spot the same key reused with a different body.
  requestHash    String           @map("request_hash")
  state          IdempotencyState @default(in_progress)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@id([merchantId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// The outbox: written in the same transaction as the change it describes.
model Event {
  id           String    @id
  merchantId   String    @map("merchant_id")
  /// payment.captured, refund.processed, ping, ...
  type         String
  payload      Json
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([dispatchedAt])
  @@index([merchantId, createdAt])
  @@map("events")
}

model WebhookEndpoint {
  id             String   @id
  merchantId     String   @map("merchant_id")
  url            String
  /// AES-256-GCM ciphertext of the whsec_ signing secret.
  secret         String
  /// Subscribed event types, or ["*"] for all.
  eventTypes     String[] @map("event_types")
  enabled        Boolean  @default(true)
  disabledReason String?  @map("disabled_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                 String                @id
  eventId            String                @map("event_id")
  endpointId         String                @map("endpoint_id")
  status             WebhookDeliveryStatus @default(pending)
  attemptCount       Int                   @default(0) @map("attempt_count")
  nextAttemptAt      DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Lease: a sender owns the delivery until then. Expired leases can be claimed again.
  lockedUntil        DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastAttemptAt      DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  lastResponseStatus Int?                  @map("last_response_status")
  lastResponseMs     Int?                  @map("last_response_ms")
  lastError          String?               @map("last_error")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event           @relation(fields: [eventId], references: [id])
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

// ---------- Back office ----------

enum SettlementStatus {
  processed

  @@map("settlement_status")
}

enum BankTransactionType {
  payment
  refund

  @@map("bank_transaction_type")
}

enum ReconciliationIssueKind {
  missing_in_gateway
  missing_in_bank
  amount_mismatch
  status_mismatch

  @@map("reconciliation_issue_kind")
}

model Settlement {
  id          String           @id
  merchantId  String           @map("merchant_id")
  periodStart DateTime         @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime         @map("period_end") @db.Timestamptz(3)
  gross       Int
  fees        Int
  refunds     Int
  net         Int
  status      SettlementStatus @default(processed)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
  @@map("settlements")
}

/// The fake bank's daily file, imported once per day.
model BankSettlementFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankDate   DateTime @unique @map("bank_date") @db.Date
  csvText    String   @map("csv_text")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rows BankSettlementRow[]

  @@map("bank_settlement_files")
}

model BankSettlementRow {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId           String              @map("file_id") @db.Uuid
  bankRef          String              @map("bank_ref")
  /// Our pay_ or rfnd_ ID, as the bank recorded it.
  gatewayReference String              @map("gateway_reference")
  type             BankTransactionType
  amount           Int
  /// The bank's status text, kept as imported.
  status           String
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  file BankSettlementFile @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([gatewayReference])
  @@map("bank_settlement_rows")
}

model ReconciliationIssue {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null when the bank has a row we can't match to any merchant (missing_in_gateway).
  merchantId       String?                 @map("merchant_id")
  bankDate         DateTime                @map("bank_date") @db.Date
  kind             ReconciliationIssueKind
  gatewayReference String?                 @map("gateway_reference")
  bankRef          String?                 @map("bank_ref")
  details          Json
  resolvedAt       DateTime?               @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([merchantId, bankDate])
  @@map("reconciliation_issues")
}

// ---------- Fake bank (its own records, kept separate from ours) ----------

enum BankOutcome {
  pending
  approved
  declined

  @@map("bank_outcome")
}

model BankTransaction {
  bankRef          String              @id @map("bank_ref")
  /// Our pay_ or rfnd_ ID.
  gatewayReference String              @map("gateway_reference")
  type             BankTransactionType
  amount           Int
  outcome          BankOutcome         @default(pending)
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz(3)
  /// False for lost@test: the bank approved but never told us.
  callbackSent     Boolean             @default(false) @map("callback_sent")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([gatewayReference])
  @@map("bank_transactions")
}
