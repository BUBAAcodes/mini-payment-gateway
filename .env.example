# Copy to .env for local development. Values match docker-compose.yml.

# Postgres
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
DIRECT_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Redis (rate limiting, step 18)
REDIS_URL=redis://localhost:6379

# API
PORT=4000
LOG_LEVEL=info
# Encrypts stored secrets (AES-256-GCM). 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Our fee in basis points (200 = 2%).
FEE_BPS=200
# The web app (dashboard + checkout). Order responses link to {WEB_BASE_URL}/pay/{orderId}.
WEB_BASE_URL=http://localhost:3000
# Fake bank: slow@test answers after BANK_SLOW_MS; we give up waiting after BANK_TIMEOUT_MS.
BANK_SLOW_MS=20000
BANK_TIMEOUT_MS=10000
# Lets webhook URLs point at private addresses (localhost, Docker services). Keep false when
# deployed, so merchants can't make our server call internal addresses (SSRF).
ALLOW_PRIVATE_WEBHOOK_URLS=true

# Web (apps/web): where its server code reaches the API. The browser never calls the API itself.
# Next.js reads env files from apps/web, so put this in apps/web/.env.local if it isn't the default.
API_BASE_URL=http://localhost:4000

# Demo store: its public URL. The seed points the demo webhook endpoint at it.
STORE_BASE_URL=http://localhost:3001
# Where the API sends the demo store's webhooks, if not {STORE_BASE_URL}/webhooks/gateway. For the
# Docker flow seed with STORE_WEBHOOK_URL=http://demo-store:3001/webhooks/gateway, because the API
# container can't reach the store at localhost:3001.
# STORE_WEBHOOK_URL=
# The demo store's secrets: `pnpm db:seed` prints them once. Paste them here.
GATEWAY_SECRET_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_CHECKOUT_SECRET=
