# Copy to .env for local development. Values match docker-compose.yml.

# Postgres
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
DIRECT_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Redis: rate-limit counters. Upstash when deployed (a rediss:// URL).
REDIS_URL=redis://localhost:6379
# Requests each API key may make per minute before getting 429.
RATE_LIMIT_PER_MINUTE=100

# API
PORT=4000
LOG_LEVEL=info
# Encrypts stored secrets (AES-256-GCM). 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Our fee in basis points (200 = 2%).
FEE_BPS=200
# The web app (dashboard + checkout). Order responses link to {WEB_BASE_URL}/pay/{orderId}.
WEB_BASE_URL=http://localhost:3000
# Fake bank: slow@test answers after BANK_SLOW_MS; we give up waiting after BANK_TIMEOUT_MS.
BANK_SLOW_MS=20000
BANK_TIMEOUT_MS=10000
# Lets webhook URLs point at private addresses (localhost, Docker services). Keep false when
# deployed, so merchants can't make our server call internal addresses (SSRF).
ALLOW_PRIVATE_WEBHOOK_URLS=true
# Protects /internal/* (settle, reconcile, cleanup), which the daily cron calls with
# "Authorization: Bearer <this>". At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTERNAL_CRON_SECRET=
# Lets the web app's server call the dashboard API (/dashboard/*) as the logged-in merchant, with
# "Authorization: Bearer <this>" and X-Merchant-Id. The API and web must have the same value. At
# least 32 characters; generate one like INTERNAL_CRON_SECRET.
DASHBOARD_SERVICE_TOKEN=
# Captures and refunds settle once they are this many days old. 0 for demos (real gateways: T+2).
SETTLEMENT_DELAY_DAYS=0

# Web (apps/web): where its server code reaches the API. The browser never calls the API itself.
# Next.js reads env files from apps/web, so for `pnpm dev` put the web settings in
# apps/web/.env.local: API_BASE_URL (if not the default), DATABASE_URL (dashboard logins live in
# Postgres), DASHBOARD_SERVICE_TOKEN, BETTER_AUTH_SECRET and BETTER_AUTH_URL.
API_BASE_URL=http://localhost:4000
# Dashboard login (Better Auth). The secret signs session cookies: 32+ random characters, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The web app's public URL.
BETTER_AUTH_URL=http://localhost:3000

# Demo store: its public URL. The seed points the demo webhook endpoint at it.
STORE_BASE_URL=http://localhost:3001
# Where the API sends the demo store's webhooks, if not {STORE_BASE_URL}/webhooks/gateway. For the
# Docker flow seed with STORE_WEBHOOK_URL=http://demo-store:3001/webhooks/gateway, because the API
# container can't reach the store at localhost:3001.
# STORE_WEBHOOK_URL=
# The demo store's secrets: `pnpm db:seed` prints them once. Paste them here.
GATEWAY_SECRET_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_CHECKOUT_SECRET=
